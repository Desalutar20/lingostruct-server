{
  "name": "lingostruct-server",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx --watch ./src/main.ts",
    "test": "vitest --run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "migration:create": "npx kysely migrate:make",
    "migration:run": "npx kysely migrate:latest",
    "migration:rollback": "npx kysely migrate:rollback --all",
    "migration:list": " npx kysely migrate:list",
    "migration:up": "npx kysely migprate:up",
    "migration:down": "npx kysely migrate:down",
    "kysely:codegen": "kysely-codegen --out-file ./src/infrastructure/data/db.types.ts --camel-case --dialect=postgres --runtime-enums=pascal-case"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@scalar/fastify-api-reference": "^1.64.1",
    "close-with-grace": "^2.5.0",
    "cron": "^4.4.0",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "js-yaml": "^5.2.3",
    "kysely": "^0.29.4",
    "neverthrow": "^8.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "redis": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
